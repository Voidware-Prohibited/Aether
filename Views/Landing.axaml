<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="using:TargetVectorLauncher.ViewModels"
             x:DataType="vm:LandingViewModel"
             x:Class="TargetVectorLauncher.Views.Landing">
    <Grid RowDefinitions="1*,1*,1*,1*" ColumnDefinitions="*" Margin="0 6 0 0">
        <TextBlock Grid.Row="0">Landing Page!!</TextBlock>
        <TextBlock Grid.Row="1" Text="{Binding JsonString}"></TextBlock>
        <TextBlock Grid.Row="2">{Binding JsonString}</TextBlock>
        <TextBlock Grid.Row="3">Landing Page!!</TextBlock>
    </Grid>
    
</UserControl>
