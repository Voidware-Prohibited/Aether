<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:TargetVectorLauncher.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="TargetVectorLauncher.Views.Play">
    <Panel>
        <TabControl Margin="0" SelectedIndex="0">
            <TabItem Header="./">
                <views:PlayDaily ClipToBounds="True"/>
            </TabItem>
            <TabItem Header="./CMPGN">
                <views:PlayCampaign ClipToBounds="True"/>
            </TabItem>
            <TabItem Header="./NET">
                <views:PlayMultiplayer ClipToBounds="True"/>
            </TabItem>
        </TabControl>
    </Panel>
</UserControl>
