<Window MaxWidth="640" MaxHeight="480"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="480"
        x:Class="TargetVectorLauncher.Views.LoadingWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="Target Vector Launcher Loading..."
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaChromeHints="NoChrome">
    <Panel ClipToBounds="True" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch"  Margin="0,0,0,0">
        <ExperimentalAcrylicBorder IsHitTestVisible="False" CornerRadius="8" ClipToBounds="True">
            <ExperimentalAcrylicBorder.Material>
                <ExperimentalAcrylicMaterial
                    BackgroundSource="Digger"
                    TintColor="Black"
                    TintOpacity="0.75"
                    MaterialOpacity="0.05" />
            </ExperimentalAcrylicBorder.Material>
        </ExperimentalAcrylicBorder>
        <!-- Background Image -->
        <Panel IsHitTestVisible="False" Margin="8" ZIndex="-0">
            <Image Source="../Assets/bg1.png" Stretch="UniformToFill" Margin="-8" StretchDirection="Both" Opacity="0.2" IsHitTestVisible="False">
                <Image.Effect>
                    <BlurEffect></BlurEffect>
                </Image.Effect>
            </Image>
        </Panel>
        <!-- Single Column Rows -->
        <Grid ColumnDefinitions="*" RowDefinitions="100,*,50*,20"  Margin="0" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch">
            <Panel Grid.Row="0">
                <Grid ColumnDefinitions="72,72,72, *, 72" Margin="8 8 8  0">
                    <Rectangle Grid.Column="0" Fill="Magenta" Margin="0 0 8 0"></Rectangle>
                    <Rectangle Grid.Column="1" Fill="Magenta"></Rectangle>
                    <Rectangle Grid.Column="2" Fill="Magenta" Margin="0 0 8 0"></Rectangle>
                    <Rectangle Grid.Column="4" Fill="Magenta"></Rectangle>
                </Grid>
            </Panel>
            <Panel Grid.Row="1" VerticalAlignment="Center" Margin="0 50 0 0">
                <Image Height="150" Width="150" Source="../Assets/avalonia-logo.ico"/>
            </Panel>
            <StackPanel Grid.Row="2" Margin="32 64 32 16" VerticalAlignment="Center">
                <ProgressBar Value="50" Margin="0 0 0 50"></ProgressBar>
                <TextBlock HorizontalAlignment="Center">
                    Loading
                </TextBlock>
            </StackPanel>
            <Panel Grid.Row="3" VerticalAlignment="Bottom">
                <TextBlock HorizontalAlignment="Center" FontSize="10">
                    Loading Detail
                </TextBlock>
            </Panel>
        </Grid>
    </Panel>
</Window>
